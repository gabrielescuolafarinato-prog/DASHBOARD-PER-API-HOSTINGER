# Required server-only values.
# Use the pooled/serverless Neon URL. Never prefix these names with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional migration-only override and Vercel/Neon unpooled fallbacks.
# The runner uses the first non-empty value in the documented priority order.
DATABASE_MIGRATION_URL=
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Required locally and for the canonical Production/custom domain.
# Production example: APP_URL=https://your-project.vercel.app
# On Vercel Preview it may be omitted when VERCEL=1: exact Vercel system
# hostnames are validated and allowlisted. Vercel normally supplies VERCEL_URL,
# VERCEL_BRANCH_URL, and VERCEL_PROJECT_PRODUCTION_URL automatically; do not
# copy them here or set them manually. Redeploy after changing Vercel variables.
APP_URL=http://localhost:3000

# Optional, server-only and indivisible: set all three or leave all three empty.
# Never use NEXT_PUBLIC_ variants and never commit a real token.
# HOSTINGER_SITE_DOMAIN must be a hostname only (no protocol, path, port or wildcard).
# After changing this group on Vercel, create a new deployment.
HOSTINGER_API_TOKEN=
HOSTINGER_ACCOUNT_USERNAME=
HOSTINGER_SITE_DOMAIN=

# Bootstrap-only variables: set temporarily in the shell, not permanently on Vercel.
# BOOTSTRAP_OWNER_EMAIL=owner@example.com
# BOOTSTRAP_OWNER_NAME=Site Owner
# BOOTSTRAP_OWNER_PASSWORD=generate-a-strong-temporary-value
